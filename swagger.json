{
  "openapi": "3.0.0",
  "info": {
    "title": "API Superhéroes y Villanos",
    "version": "1.0.0",
    "description": "API para gestionar superhéroes, villanos y enfrentamientos."
  },
  "servers": [
    { "url": "http://localhost:3001" }
  ],
  "paths": {
    "/api/heroes": {
      "get": {
        "summary": "Obtener todos los héroes",
        "responses": {
          "200": {
            "description": "Lista de héroes",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Hero" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear un héroe",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Hero" }
            }
          }
        },
        "responses": {
          "201": { "description": "Héroe creado" }
        }
      }
    },
    "/api/heroes/{id}": {
      "put": {
        "summary": "Actualizar un héroe",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Hero" }
            }
          }
        },
        "responses": { "200": { "description": "Héroe actualizado" } }
      },
      "delete": {
        "summary": "Eliminar un héroe",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Héroe eliminado" } }
      }
    },
    "/api/villains": {
      "get": {
        "summary": "Obtener todos los villanos",
        "responses": {
          "200": {
            "description": "Lista de villanos",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Villain" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear un villano",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Villain" }
            }
          }
        },
        "responses": {
          "201": { "description": "Villano creado" }
        }
      }
    },
    "/api/villains/{id}": {
      "put": {
        "summary": "Actualizar un villano",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Villain" }
            }
          }
        },
        "responses": { "200": { "description": "Villano actualizado" } }
      },
      "delete": {
        "summary": "Eliminar un villano",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Villano eliminado" } }
      }
    },
    "/api/battles": {
      "get": {
        "summary": "Obtener todos los enfrentamientos",
        "responses": {
          "200": {
            "description": "Lista de enfrentamientos",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Battle" } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Crear un enfrentamiento",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "heroId": { "type": "integer" },
                  "villainId": { "type": "integer" },
                  "winner": { "type": "string", "enum": ["hero", "villain"] }
                },
                "required": ["heroId", "villainId", "winner"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Enfrentamiento creado" }
        }
      }
    },
    "/api/battles/turn-based-teams": {
      "post": {
        "summary": "Crear batalla 3vs3 manual",
        "description": "Crea una batalla 3vs3 entre equipos de héroes y villanos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "heroTeam": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "example": [1, 2, 3]
                  },
                  "villainTeam": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "example": [4, 5, 6]
                  }
                },
                "required": ["heroTeam", "villainTeam"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Batalla creada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TurnBasedTeamBattle" }
              }
            }
          },
          "400": { "description": "Datos inválidos" }
        }
      }
    },
    "/api/battles/turn-based-teams/{battleId}": {
      "get": {
        "summary": "Obtener batalla 3vs3 manual por ID",
        "parameters": [
          {
            "name": "battleId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Estado de la batalla",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TurnBasedTeamBattle" }
              }
            }
          },
          "404": { "description": "Batalla no encontrada" }
        }
      }
    },
    "/api/battles/turn-based-teams/{battleId}/attack": {
      "post": {
        "summary": "Realizar ataque manual en batalla 3vs3",
        "description": "Permite que un personaje de un equipo ataque a un personaje del equipo contrario. El ataque puede ser básico o especial.",
        "parameters": [
          {
            "name": "battleId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attackerType": { "type": "string", "enum": ["hero", "villain"] },
                  "attackerIndex": { "type": "integer" },
                  "defenderIndex": { "type": "integer" },
                  "attackType": { "type": "string", "enum": ["basic", "special"] }
                },
                "required": ["attackerType", "attackerIndex", "defenderIndex", "attackType"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del ataque",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TurnBasedTeamBattle" }
              }
            }
          },
          "400": { "description": "Datos inválidos" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Hero": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "alias": { "type": "string" },
          "city": { "type": "string" },
          "team": { "type": "string" }
        }
      },
      "Villain": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "alias": { "type": "string" },
          "city": { "type": "string" },
          "team": { "type": "string" }
        }
      },
      "Battle": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "heroId": { "type": "integer" },
          "villainId": { "type": "integer" },
          "winner": { "type": "string" },
          "date": { "type": "string", "format": "date-time" }
        }
      },
      "TurnBasedTeamBattle": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string", "example": "turn-based-teams-manual" },
          "heroTeam": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "life": { "type": "integer" },
                "maxLife": { "type": "integer" },
                "shield": { "type": "integer" },
                "maxShield": { "type": "integer" },
                "powerBar": { "type": "integer" }
              }
            }
          },
          "villainTeam": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "life": { "type": "integer" },
                "maxLife": { "type": "integer" },
                "shield": { "type": "integer" },
                "maxShield": { "type": "integer" },
                "powerBar": { "type": "integer" }
              }
            }
          },
          "turns": {
            "type": "array",
            "items": { "type": "object" }
          },
          "status": { "type": "string" },
          "winner": { "type": ["string", "null"] },
          "date": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
} 